    <UserControl x:Class="TiaGitAddIn.UI.Views.DiffView"
             x:Name="DiffRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comparison="clr-namespace:TiaGitAddIn.UI.Views.Comparison"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToBackground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertVis" Invert="True"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"
                                  MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource ChangedBrush}"
                        CornerRadius="3"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ComparisonKind}" FontWeight="SemiBold"/>
                </Border>
                <Button DockPanel.Dock="Right"
                        Content="Next file"
                        Command="{Binding NextFileCommand}"
                        Margin="6,0,0,0"
                        Padding="8,2"/>
                <Button DockPanel.Dock="Right"
                        Content="Previous file"
                        Command="{Binding PreviousFileCommand}"
                        Padding="8,2"/>
                <Button DockPanel.Dock="Left"
                        Content="Choose files"
                        Command="{Binding ChooseFilesCommand}"
                        Margin="0,0,6,0"
                        Padding="8,2"
                        ToolTip="Show every version of the files you pick, in one view. Files outside the repository are refused."/>
                <TextBox Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Show files whose path contains this text."/>
            </DockPanel>

            <!-- File list panel -->
            <TreeView Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding FileTree}"
                      BorderThickness="0"
                      SelectedItemChanged="OnSelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.Resources>
                    <conv:BoolToVisibilityConverter x:Key="FileVis"/>
                    <conv:BoolToVisibilityConverter x:Key="GroupVis" Invert="True"/>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ChangeNode}"
                                              ItemsSource="{Binding Children}">
                        <Grid Margin="0,2">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsFile, Converter={StaticResource GroupVis}}"/>
                            <Grid Visibility="{Binding IsFile, Converter={StaticResource FileVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Padding="2,0"
                                        Background="{Binding Item.ChangeType, Converter={StaticResource LineTypeToBackground}}">
                                    <TextBlock Text="{Binding Item.ChangeType}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           ToolTip="{Binding Item.FilePath}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="0,1"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Row="1"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Diff content panel: every artifact kind (text, LAD, interface-only, unsupported, error)
                 renders through the one ComparisonPresentationHost, driven entirely by CurrentPresentation.
                 Show history replaces that one comparison with every version, stacked. -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="8,0,8,4">
                    <Button DockPanel.Dock="Right"
                            Content="Show history"
                            Command="{Binding ShowHistoryCommand}"
                            Padding="8,2"
                            Visibility="{Binding HasFileHistory, Converter={StaticResource InvertVis}}"
                            ToolTip="Show every version of this file in one view. The newest is at the top."/>
                    <Button DockPanel.Dock="Right"
                            Content="Close history"
                            Command="{Binding CloseHistoryCommand}"
                            Padding="8,2"
                            Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}"
                            ToolTip="Return to the comparison that was open."/>
                    <TextBlock Text="Every version of this file, newest at the top. Each block is the change made in that commit."
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="DimGray"
                               Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
                <comparison:ComparisonPresentationHost Grid.Row="1"
                                                        DataContext="{Binding CurrentPresentation}"
                                                        Visibility="{Binding DataContext.HasFileHistory, ElementName=DiffRoot, Converter={StaticResource InvertVis}}"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                              Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FileHistorySections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,0,1"
                                        Margin="0,0,0,12"
                                        Padding="0,0,0,12"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Margin="8,8,8,6"
                                                   TextWrapping="Wrap"/>
                                        <comparison:ComparisonPresentationHost DataContext="{Binding Presentation}"
                                                                                Height="520"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                           Foreground="DimGray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Padding="10,2"
                        ToolTip="Save the changed-file list and the open comparison as a PDF. A ladder is written as networks, and a screen lists the highlighted items."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
