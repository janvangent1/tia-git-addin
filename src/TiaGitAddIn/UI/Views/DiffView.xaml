<UserControl x:Class="TiaGitAddIn.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comparison="clr-namespace:TiaGitAddIn.UI.Views.Comparison"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToBackground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"
                                  MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File list panel -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding FileTree}"
                      BorderThickness="0"
                      SelectedItemChanged="OnSelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.Resources>
                    <conv:BoolToVisibilityConverter x:Key="FileVis"/>
                    <conv:BoolToVisibilityConverter x:Key="GroupVis" Invert="True"/>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ChangeNode}"
                                              ItemsSource="{Binding Children}">
                        <Grid Margin="0,2">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsFile, Converter={StaticResource GroupVis}}"/>
                            <Grid Visibility="{Binding IsFile, Converter={StaticResource FileVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Padding="2,0"
                                        Background="{Binding Item.ChangeType, Converter={StaticResource LineTypeToBackground}}">
                                    <TextBlock Text="{Binding Item.ChangeType}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           ToolTip="{Binding Item.FilePath}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="0,1"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- Diff content panel: every artifact kind (text, LAD, interface-only, unsupported, error)
                 renders through the one ComparisonPresentationHost, driven entirely by CurrentPresentation. -->
            <comparison:ComparisonPresentationHost Grid.Column="2"
                                                    DataContext="{Binding CurrentPresentation}"/>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                           Foreground="DimGray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Padding="10,2"
                        ToolTip="Save the changed-file list and the open text diff as a PDF. Ladder diagrams are left out."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
