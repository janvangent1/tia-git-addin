    <UserControl x:Class="TiaGitAddIn.UI.Views.DiffView"
             x:Name="DiffRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:comparison="clr-namespace:TiaGitAddIn.UI.Views.Comparison"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToBackground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertVis" Invert="True"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"
                                  MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource ChangedBrush}"
                        CornerRadius="3"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ComparisonKind}" FontWeight="SemiBold"/>
                </Border>
                <Button DockPanel.Dock="Right"
                        Content="Next file"
                        Command="{Binding NextFileCommand}"
                        Margin="6,0,0,0"
                        Padding="8,2"/>
                <Button DockPanel.Dock="Right"
                        Content="Previous file"
                        Command="{Binding PreviousFileCommand}"
                        Padding="8,2"/>
                <Button DockPanel.Dock="Left"
                        Content="{Binding ReviewButtonText}"
                        Command="{Binding ToggleReviewCommand}"
                        Margin="0,0,6,0"
                        Padding="8,2"
                        ToolTip="List the SCL blocks in this commit, with the software-unit folder, and step from one block to the next."/>
                <Button DockPanel.Dock="Left"
                        Content="Choose files"
                        Command="{Binding ChooseFilesCommand}"
                        Margin="0,0,6,0"
                        Padding="8,2"
                        ToolTip="Show every version of the files you pick, in one view. Files outside the repository are refused."/>
                <TextBox Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Show files whose path contains this text."/>
            </DockPanel>

            <!-- File list panel -->
            <TreeView Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding FileTree}"
                      BorderThickness="0"
                      SelectedItemChanged="OnSelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsReviewingCommit, Converter={StaticResource InvertVis}}">
                <TreeView.Resources>
                    <conv:BoolToVisibilityConverter x:Key="FileVis"/>
                    <conv:BoolToVisibilityConverter x:Key="GroupVis" Invert="True"/>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ChangeNode}"
                                              ItemsSource="{Binding Children}">
                        <Grid Margin="0,2">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsFile, Converter={StaticResource GroupVis}}"/>
                            <Grid Visibility="{Binding IsFile, Converter={StaticResource FileVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Padding="2,0"
                                        Background="{Binding Item.ChangeType, Converter={StaticResource LineTypeToBackground}}">
                                    <TextBlock Text="{Binding Item.ChangeType}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           ToolTip="{Binding Item.FilePath}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="0,1"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <DockPanel Grid.Row="1"
                       Grid.Column="0"
                       Visibility="{Binding IsReviewingCommit, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,6">
                    <TextBlock Text="SCL blocks in this commit" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Previous block" Command="{Binding PreviousBlockCommand}" Padding="8,2" Margin="0,0,6,0"/>
                        <Button Content="Next block" Command="{Binding NextBlockCommand}" Padding="8,2"/>
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding ReviewBlocks}"
                         SelectedItem="{Binding SelectedReviewBlock, Mode=TwoWay}"
                         BorderThickness="0"
                         SelectionChanged="OnReviewSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Caption}" Margin="2" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="1"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"/>

            <!-- One comparison stays open. File history is a list of versions beside it. -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="8,0,8,4">
                    <Button DockPanel.Dock="Right"
                            Content="Show history"
                            Command="{Binding ShowHistoryCommand}"
                            Padding="8,2"
                            Visibility="{Binding HasFileHistory, Converter={StaticResource InvertVis}}"
                            ToolTip="List every version of this file. Open one version in the comparison."/>
                    <Button DockPanel.Dock="Right"
                            Content="Close history"
                            Command="{Binding CloseHistoryCommand}"
                            Padding="8,2"
                            Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}"
                            ToolTip="Hide the version list."/>
                    <TextBlock Text="Each line is one version. Select it to open that comparison."
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="DimGray"
                               Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
                <ListBox Grid.Row="1"
                         Grid.Column="0"
                         Width="280"
                         ItemsSource="{Binding FileHistoryLines}"
                         SelectedItem="{Binding SelectedHistoryLine, Mode=TwoWay}"
                         SelectionChanged="OnHistorySelected"
                         BorderThickness="0"
                         Visibility="{Binding HasFileHistory, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Regions}" Foreground="DimGray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <comparison:ComparisonPresentationHost Grid.Row="1"
                                                        Grid.Column="1"
                                                        DataContext="{Binding CurrentPresentation}"/>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                           Foreground="DimGray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Padding="10,2"
                        ToolTip="Save the changed-file list and the open comparison as a PDF. A ladder is written as networks, and a screen lists the highlighted items."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
