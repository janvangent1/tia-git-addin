<UserControl x:Class="TiaGitAddIn.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TiaGitAddIn.UI.Views"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
        d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Git Executable Path:"
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding GitExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"/>
        <Button Content="Browse..."
                Command="{Binding BrowseGitExeCommand}"
                Grid.Row="0"
                Grid.Column="2"
                Padding="10,2"
                Margin="5"
                VerticalAlignment="Center"/>

        <Label Content="Your Name:"
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding CommitAuthorName, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"/>

        <Label Content="Your Email:"
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding CommitAuthorEmail, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"/>

        <Label Content="Repository Path:"
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding RepositoryPath}"
                Grid.Row="3"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Background="#F0F0F0"/>

        <Label Content="Default Remote:"
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding DefaultRemote, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="4"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"/>

        <Label Content="Remote URL:"
                Grid.Row="5"
                Grid.Column="0"
                VerticalAlignment="Center"
                ToolTip="GitHub or Azure DevOps clone URL."/>
        <TextBox Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="5"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="5"
                VerticalAlignment="Center"
                ToolTip="Example: https://github.com/org/repo.git or https://dev.azure.com/org/project/_git/repo. Leave the password out. Save points the remote named above at this repository."/>

        <Label Content="Max Log Entries:"
                Grid.Row="6"
                Grid.Column="0"
                VerticalAlignment="Center"/>
        <TextBox Text="{Binding MaxLogEntries, UpdateSourceTrigger=PropertyChanged}"
                Grid.Row="6"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                Width="100"
                HorizontalAlignment="Left"/>

        <Label Content="XML changes:"
                Grid.Row="7"
                Grid.Column="0"
                VerticalAlignment="Center"
                ToolTip="Choose how exported XML is shown in a diff."/>
        <ComboBox ItemsSource="{Binding XmlDiffChoices}"
                SelectedItem="{Binding SelectedXmlDiff}"
                DisplayMemberPath="Caption"
                Grid.Row="7"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                MinWidth="220"
                ToolTip="By element and attribute ignores formatting and attribute order. Plain text shows the file line by line."/>

        <Label Content="Screen:"
                Grid.Row="8"
                Grid.Column="0"
                VerticalAlignment="Center"
                ToolTip="Choose how an exported screen is shown in a diff."/>
        <ComboBox ItemsSource="{Binding ScreenDiffChoices}"
                SelectedItem="{Binding SelectedScreenDiff}"
                DisplayMemberPath="Caption"
                Grid.Row="8"
                Grid.Column="1"
                Margin="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                MinWidth="220"
                ToolTip="Screen preview draws buttons and I/O fields. XML text shows the exported file."/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,12,5,0">
            <TextBlock Text="Whitespace" FontWeight="Bold"/>
            <TextBlock Text="These follow Git's diff options. If several are checked, the strongest one is used. Ignore all white space covers the others, except blank lines. Save stores every setting in this workspace. Then open the diff again."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,2,0,6"/>
            <CheckBox Content="-E, --ignore-tab-expansion    ignore changes due to tab expansion"
                      IsChecked="{Binding IgnoreTabExpansion}"
                      Margin="0,2,0,2"
                      ToolTip="A tab and the spaces it expands to are the same change."/>
            <CheckBox Content="-Z, --ignore-trailing-space    ignore white space at line end"
                      IsChecked="{Binding IgnoreTrailingSpace}"
                      Margin="0,2,0,2"/>
            <CheckBox Content="-b, --ignore-space-change    ignore changes in the amount of white space"
                      IsChecked="{Binding IgnoreSpaceChange}"
                      Margin="0,2,0,2"/>
            <CheckBox Content="-w, --ignore-all-space    ignore all white space"
                      IsChecked="{Binding IgnoreAllSpace}"
                      Margin="0,2,0,2"/>
            <CheckBox Content="-B, --ignore-blank-lines    ignore changes whose lines are all blank"
                      IsChecked="{Binding IgnoreBlankLines}"
                      Margin="0,2,0,2"/>
            <CheckBox Content="Ignore comments    // and (* *) or *( *)"
                      IsChecked="{Binding IgnoreComments}"
                      Margin="0,8,0,2"
                      ToolTip="A comment starts with //, or sits between (* and *) or *( and *). Off until you check it. Save, then open the diff again."/>
        </StackPanel>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,12,5,0">
            <TextBlock Text="Export these HMI items" FontWeight="Bold"/>
            <TextBlock Text="Unchecked items are left out of the next export. Comfort items with the same name follow these boxes. Save before you export."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,2,0,6"/>
            <ItemsControl ItemsSource="{Binding HmiCategories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsChecked}"
                                  Margin="0,2,16,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Export these hardware items" FontWeight="Bold" Margin="0,10,0,4"/>
            <ItemsControl ItemsSource="{Binding HardwareCategories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsChecked}"
                                  Margin="0,2,16,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding ValidationMessage}"
                Grid.Row="11"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Foreground="Red"
                Margin="5,10"
                TextWrapping="Wrap"/>

        <Button Content="Save Settings"
                Command="{Binding SaveCommand}"
                Grid.Row="12"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Padding="20,5"
                Margin="5"/>
    </Grid>
    </ScrollViewer>
</UserControl>
