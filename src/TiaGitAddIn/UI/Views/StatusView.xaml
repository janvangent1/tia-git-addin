<UserControl x:Class="TiaGitAddIn.UI.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             xmlns:conv="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <conv:FileStatusToColorConverter x:Key="StatusToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="GroupVis" Invert="True"/>

        <HierarchicalDataTemplate x:Key="StatusNodeTemplate"
                                  DataType="{x:Type vm:ChangeNode}"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="0,2">
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsFile, Converter={StaticResource GroupVis}}"/>
                <Grid Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            CornerRadius="2"
                            Background="{Binding Item.Status, Converter={StaticResource StatusToColor}}"
                            ToolTip="{Binding Item.StatusText}">
                        <TextBlock Text="{Binding Item.StatusBadge}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               ToolTip="{Binding Item.FilePath}"
                               Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="ChangeTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusSummary}"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
            <TextBox Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Show files whose path contains this text."/>
        </DockPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <Expander Header="Conflicts — Git cannot merge these files by itself"
                          IsExpanded="True"
                          Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Compare both sides"
                                    Command="{Binding CompareConflictCommand}"
                                    Padding="8,2"
                                    Margin="0,0,6,0"
                                    ToolTip="Show the two sides of the selected conflict in the comparison."/>
                            <Button Content="Mark resolved"
                                    Command="{Binding MarkResolvedCommand}"
                                    Padding="8,2"
                                    ToolTip="After the file is fixed in TIA, tell Git to keep that file."/>
                        </StackPanel>
                        <TreeView ItemsSource="{Binding ConflictedGroups}"
                              ItemTemplate="{StaticResource StatusNodeTemplate}"
                              ItemContainerStyle="{StaticResource ChangeTreeItemStyle}"
                              BorderThickness="0"
                              SelectedItemChanged="OnSelectionChanged"
                              MouseDoubleClick="OnDoubleClick"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Staged Changes" IsExpanded="True" Margin="0,8,0,0">
                    <TreeView ItemsSource="{Binding StagedGroups}"
                              ItemTemplate="{StaticResource StatusNodeTemplate}"
                              ItemContainerStyle="{StaticResource ChangeTreeItemStyle}"
                              BorderThickness="0"
                              SelectedItemChanged="OnSelectionChanged"
                              MouseDoubleClick="OnDoubleClick"/>
                </Expander>

                <Expander Header="Unstaged Changes" IsExpanded="True" Margin="0,8,0,0">
                    <TreeView ItemsSource="{Binding UnstagedGroups}"
                              ItemTemplate="{StaticResource StatusNodeTemplate}"
                              ItemContainerStyle="{StaticResource ChangeTreeItemStyle}"
                              BorderThickness="0"
                              SelectedItemChanged="OnSelectionChanged"
                              MouseDoubleClick="OnDoubleClick"/>
                </Expander>

                <Expander Header="Untracked Files" IsExpanded="True" Margin="0,8,0,0">
                    <TreeView ItemsSource="{Binding UntrackedGroups}"
                              ItemTemplate="{StaticResource StatusNodeTemplate}"
                              ItemContainerStyle="{StaticResource ChangeTreeItemStyle}"
                              BorderThickness="0"
                              SelectedItemChanged="OnSelectionChanged"
                              MouseDoubleClick="OnDoubleClick"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StatusBar Grid.Row="2"
                   Background="Transparent"
                   BorderThickness="0,1,0,0"
                   BorderBrush="{StaticResource LineBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}" Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Stage" Command="{Binding StageSelectedCommand}" Padding="10,2" ToolTip="Stage the selected file."/>
                    <Button Content="Unstage" Command="{Binding UnstageSelectedCommand}" Margin="5,0,0,0" Padding="10,2"/>
                    <Button Content="Discard"
                            Command="{Binding DiscardSelectedCommand}"
                            Margin="5,0,0,0"
                            Padding="10,2"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Put the selected file back to the last commit."/>
                    <Button Content="Show changes"
                            Command="{Binding ShowChangesCommand}"
                            Margin="12,0,0,0"
                            Padding="10,2"
                            ToolTip="Compare the current workspace files with the last commit."/>
                    <Button Content="Stage All" Command="{Binding StageAllCommand}" Margin="5,0,0,0" Padding="10,2"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="5,0,0,0" Padding="10,2"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
