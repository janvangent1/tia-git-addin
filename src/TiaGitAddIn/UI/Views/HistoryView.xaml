<UserControl x:Class="TiaGitAddIn.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TiaGitAddIn.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
        d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"
                    MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Commit log -->
        <ListView x:Name="CommitList"
                  Grid.Row="0"
                  SizeChanged="OnCommitListSizeChanged"
                  ItemsSource="{Binding Commits}"
                  SelectedItem="{Binding SelectedCommit}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Hash"
                            Width="75">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Hash}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Hash}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Author"
                            Width="140"
                            DisplayMemberBinding="{Binding AuthorName}"/>
                    <GridViewColumn Header="Date"
                            Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AuthorDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="MessageColumn"
                            Header="Message"
                            Width="450"
                            DisplayMemberBinding="{Binding Subject}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#DDDDDD"/>

        <!-- Detail panel -->
        <Grid Grid.Row="2"
                Margin="5,3,5,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Commit metadata + message -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{StaticResource LineBrush}"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Message"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedCommit.Subject}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="#DDDDDD"/>

            <!-- Changed files -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#F5F5F5"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Changed Files"
                                   FontWeight="Bold"
                                   Padding="8,5,8,5"/>
                    </Border>
                    <TreeView ItemsSource="{Binding ChangedFileGroups}"
                              BorderThickness="0"
                              SelectedItemChanged="OnFileSelected"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ChangeNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Item}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                                <Setter Property="Padding" Value="0,1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3"
                Background="Transparent"
                   BorderThickness="0,1,0,0"
                BorderBrush="#DDD">
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperationMessage}"
                        Foreground="DimGray"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export PDF"
                            Command="{Binding ExportPdfCommand}"
                            Margin="0,0,8,0"
                            Padding="10,2"
                            ToolTip="Save the loaded commits on the first page, and the changed files of each commit on the following pages."/>
                    <Button Content="Restore this commit"
                            Command="{Binding RestoreCommand}"
                            Margin="0,0,8,0"
                            Padding="10,2"
                            ToolTip="Create a new branch at the selected commit and check it out. Later commits stay on the current branch."/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="10,2"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
