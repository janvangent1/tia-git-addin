<UserControl x:Class="TiaGitAddIn.UI.Views.Comparison.TextDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="700">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LineRowStyle"
               TargetType="Grid">
            <Style.Triggers>
                <!-- Bound against the already-stringified StatusLabel (not the Kind enum) so the
                     comparison is a plain string match, not an enum/string conversion. -->
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="+">
                    <Setter Property="Background"
                            Value="{StaticResource AddedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="−">
                    <Setter Property="Background"
                            Value="{StaticResource RemovedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}"
                             Value="…">
                    <Setter Property="Background"
                            Value="#EFEFEF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="4,4,4,2"
                    Visibility="{Binding ShowTextLines, Converter={StaticResource BoolToVis}}">
            <Button Content="Previous change"
                    Command="{Binding PreviousChangeCommand}"
                    Padding="8,2"
                    ToolTip="Scroll to the previous changed block."/>
            <Button Content="Next change"
                    Command="{Binding NextChangeCommand}"
                    Margin="6,0,0,0"
                    Padding="8,2"
                    ToolTip="Scroll to the next changed block."/>
            <TextBlock Text="{Binding ChangePositionText}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#555555"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="0,0,0,1"
                Padding="6,3"
                Visibility="{Binding ShowTruncationBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Diff truncated: this comparison exceeded the configured size limits."
                       FontSize="11"
                       Foreground="#856404"/>
        </Border>

        <ScrollViewer Grid.Row="2"
                      MaxHeight="280"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasScreenPreview, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ScreenPanes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,4">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="This side has no screen."
                                       FontStyle="Italic"
                                       Foreground="#666666"
                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="#F7F7F7"
                                    Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                <ItemsControl ItemsSource="{Binding Boxes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding ScaledLeft}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding ScaledTop}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding ScaledWidth}"
                                                    Height="{Binding ScaledHeight}"
                                                    BorderThickness="1"
                                                    BorderBrush="#666666"
                                                    ToolTip="{Binding Label}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Change}" Value="Added">
                                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Change}" Value="Removed">
                                                                <Setter Property="Background" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Change}" Value="Changed">
                                                                <Setter Property="Background" Value="#FFF3B0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}"
                                                           Margin="2"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ListView Grid.Row="2"
                  MaxHeight="160"
                  BorderThickness="0"
                  ItemsSource="{Binding TagRows}"
                  Visibility="{Binding HasTagPreview, Converter={StaticResource BoolToVis}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Change" DisplayMemberBinding="{Binding Change}" Width="90"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="140"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="140"/>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding DataType}" Width="120"/>
                    <GridViewColumn Header="Comment" DisplayMemberBinding="{Binding Comment}" Width="220"/>
                </GridView>
            </ListView.View>
        </ListView>

        <ListView Grid.Row="3"
                  x:Name="LinesListView"
                  Visibility="{Binding ShowTextLines, Converter={StaticResource BoolToVis}}"
                  BorderThickness="0"
                  ItemsSource="{Binding Lines}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Style="{StaticResource LineRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LeftLineNumber}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#999999"
                                   HorizontalAlignment="Right"
                                   Padding="0,0,6,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RightLineNumber}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#999999"
                                   HorizontalAlignment="Right"
                                   Padding="0,0,6,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Text}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="NoWrap"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"
                            Value="0"/>
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
