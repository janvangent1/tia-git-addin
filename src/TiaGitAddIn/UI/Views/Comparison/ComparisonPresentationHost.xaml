<UserControl x:Class="TiaGitAddIn.UI.Views.Comparison.ComparisonPresentationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TiaGitAddIn.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComparisonTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: mode/support-level summary shared by every presentation kind. -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Header}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="8,8,8,4"/>

        <!-- Limitation panel: hidden only for Full support; every other level explains its narrowing. -->
        <Border x:Name="LimitationPanel"
                Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFEEBA"
                BorderThickness="1"
                Margin="8,0,8,4"
                Padding="8,4"
                Visibility="{Binding HasLimitation, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Limitation}"
                       TextWrapping="Wrap"
                       Foreground="#856404"/>
        </Border>

        <!-- Diagnostics: expandable, hidden entirely when there are none. -->
        <Expander x:Name="DiagnosticsExpander"
                  Grid.Row="2"
                  Header="Diagnostics"
                  Margin="8,0,8,4"
                  IsExpanded="False">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Metadata.Diagnostics.Count}"
                                     Value="0">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <ItemsControl ItemsSource="{Binding Metadata.Diagnostics}"
                          Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="2">
                            <TextBlock Text="{Binding Severity}"
                                       FontWeight="Bold"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Code}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LocationLabel}"
                                       Foreground="Gray"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Semantic content: TabControl with the dedicated presentation view plus an optional raw-text tab. -->
        <TabControl x:Name="ComparisonTabs"
                    Grid.Row="3"
                    Margin="4,0,4,4">
            <TabItem Header="Comparison">
                <ContentControl Content="{Binding}"/>
            </TabItem>
            <TabItem x:Name="RawTextTab"
                     Header="Raw text"
                     Visibility="{Binding HasRawText, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2">
                        <Button Content="Previous change"
                                Command="{Binding Metadata.RawText.PreviousChangeCommand}"
                                Padding="8,2"
                                ToolTip="Scroll to the previous changed block."/>
                        <Button Content="Next change"
                                Command="{Binding Metadata.RawText.NextChangeCommand}"
                                Margin="6,0,0,0"
                                Padding="8,2"
                                ToolTip="Scroll to the next changed block."/>
                        <TextBlock Text="{Binding Metadata.RawText.ChangePositionText}"
                                   Margin="10,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"/>
                        <Border Width="14" Height="14" Background="#F5B7B1" Margin="0,0,4,0"/>
                        <TextBlock Text="Only in Previous" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Width="14" Height="14" Background="#A9DFBF" Margin="0,0,4,0"/>
                        <TextBlock Text="Only in Current" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Matching lines stay plain." VerticalAlignment="Center" Foreground="#777777"/>
                        <TextBlock Text="The file was too long to color every line."
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Foreground="#856404"
                                   Visibility="{Binding Metadata.RawText.IsTruncated, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Previous" FontWeight="Bold" Margin="28,0,4,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Current" FontWeight="Bold" Margin="28,0,4,2"/>
                        <ListView x:Name="RawTextLines"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  BorderThickness="0"
                                  ItemsSource="{Binding Metadata.RawText.Lines}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LeftNumber}"
                                                   Foreground="#888888"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Margin="2,0"/>
                                        <Border Grid.Column="1" Background="{Binding LeftFill}">
                                            <TextBlock Text="{Binding LeftText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding RightNumber}"
                                                   Foreground="#888888"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Margin="2,0"/>
                                        <Border Grid.Column="3" Background="{Binding RightFill}">
                                            <TextBlock Text="{Binding RightText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
